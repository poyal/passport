+
+  // Both kill and the native exit watcher can win the shutdown race.
+  // Always release the console before removing its only owning baton.
+  // The caller holds g_ptyHandlesMutex; closing is therefore exactly once.
+  void closeConsole() {
+    if (hpc && closePseudoConsole) {
+      const HPCON console = hpc;
+      hpc = nullptr;
+      closePseudoConsole(console);
+    }
+  }
 
   pty_baton(int _id, HANDLE _hIn, HANDLE _hOut, HPCON _hpc) : id(_id), hIn(_hIn), hOut(_hOut), hpc(_hpc) {};
 };

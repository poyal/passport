{
  "name": "passport",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "로컬 AI와 SSH를 함께 사용하는 터미널 작업 공간",
  "author": {
    "name": "Poyal",
    "email": "poyal.work@gmail.com",
    "url": "https://github.com/poyal/passport"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:e2e:show": "npm run build && node scripts/e2e.mjs --show",
    "test:e2e:desktop": "npm run build && node scripts/e2e.mjs --desktop",
    "check": "tsc --noEmit && node scripts/test.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:check": "npm run check && npm run test:release",
    "release:verify": "node scripts/release-verify.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "postinstall": "node scripts/patch-ssh2.mjs && electron-builder install-app-deps && node scripts/prepare-node-pty.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:signed": "node -e \"require('./electron-builder.mac-signed.cjs')\" && npm run build && electron-builder --config electron-builder.mac-signed.cjs --mac dmg --arm64 --publish never",
    "dist:win": "npm run prepare:runtime -- x64 && npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write src tests scripts *.config.ts",
    "dist:win:arm64": "npm run prepare:runtime -- arm64 && npm run build && electron-builder --win nsis --arm64",
    "test:ssh:docker": "node scripts/docker-ssh.mjs",
    "test:terminal:large": "npm run build && node scripts/terminal-large.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "docs:screenshots": "esbuild scripts/docs-screenshots.mjs --bundle --platform=node --format=esm --packages=external --outfile=release/checks/docs-screenshots/runner.mjs && node release/checks/docs-screenshots/runner.mjs"
  },
  "build": {
    "appId": "io.passport.desktop",
    "productName": "Passport",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/font-list/libs/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "afterPack": "scripts/after-pack.mjs",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/terminal/helper/darwin-${arch}",
          "to": "terminal/helper/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        },
        {
          "from": "resources/terminal/helper/win32-${arch}",
          "to": "terminal/helper/win32-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/terminal/runtime/${arch}",
          "to": "terminal/runtime/${arch}",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/check-resources.cjs",
    "extraResources": [
      {
        "from": "resources/terminal/runtime-manifest.json",
        "to": "terminal/runtime-manifest.json"
      }
    ]
  },
  "dependencies": {
    "@fontsource/cascadia-code": "5.3.0",
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "6.2.1",
    "better-sqlite3": "13.0.3",
    "font-list": "2.1.0",
    "lucide-react": "1.48.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
